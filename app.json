{
  "expo": {
    "name": "flikkables-mobile",
    "slug": "flikkables-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flikkables-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.newly.flikkablesmobile"
    },
    "android": {
      "package": "com.newly.flikkablesmobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-newly-build-provenance",
      [
        "expo-dev-client",
        {
          "android": {
            "launchMode": "most-recent",
            "toolsButton": false,
            "skipOnboarding": true,
            "showMenuAtLaunch": false
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Flikkables uses your location to set your home spot and to find Flikkables that landed near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Flikkables uses your camera to take selfie postcards with the Flikkables you find.",
          "photosPermission": "Flikkables lets you pick a photo from your library to make a selfie postcard.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
