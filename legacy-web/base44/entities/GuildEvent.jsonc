{
  "name": "GuildEvent",
  "type": "object",
  "properties": {
    "guild_id": {
      "type": "string",
      "description": "ID of the guild hosting the event"
    },
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "weekly_challenge",
        "race",
        "treasure_hunt",
        "distance_marathon"
      ],
      "description": "Type of event"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "When event starts"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "When event ends"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "completed"
      ],
      "default": "upcoming",
      "description": "Event status"
    },
    "target": {
      "type": "number",
      "description": "Target goal for the event"
    },
    "current_progress": {
      "type": "number",
      "default": 0,
      "description": "Current progress towards goal"
    },
    "reward_stamps": {
      "type": "number",
      "default": 0,
      "description": "Stamps awarded for completion"
    },
    "leaderboard": {
      "type": "string",
      "description": "JSON array of participant scores"
    }
  },
  "required": [
    "guild_id",
    "title",
    "event_type",
    "start_date",
    "end_date"
  ]
}