{
  "name": "UserGardenItem",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who owns this item"
    },
    "decoration_id": {
      "type": "string",
      "description": "ID of the GardenDecoration"
    },
    "decoration_name": {
      "type": "string",
      "description": "Name of the decoration"
    },
    "decoration_emoji": {
      "type": "string",
      "description": "Emoji of the decoration"
    },
    "position_x": {
      "type": "number",
      "description": "X position in percentage (0-100)"
    },
    "position_y": {
      "type": "number",
      "description": "Y position in percentage (0-100)"
    },
    "is_placed": {
      "type": "boolean",
      "default": false,
      "description": "Whether item is placed in garden or in inventory"
    },
    "is_active_theme": {
      "type": "boolean",
      "default": false,
      "description": "Whether this theme is currently active"
    }
  },
  "required": [
    "user_email",
    "decoration_id"
  ]
}